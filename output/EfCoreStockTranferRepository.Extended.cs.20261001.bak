            IConfiguration configuration,
            IdentityUserManager userManager,
            IPasswordHasher<Volo.Abp.Identity.IdentityUser> passwordHasher,
            ISalesTeamRepository salesTeamRepository,
            IBinRepository binRepository,
            IProductRepository productRepository,
            IDeliveryAddressRepository deliveryAddressRepository,
            ICustomerRepository customerRepository,
            IProductComponentRepository productComponentRepository,
            IProductUOMRepository productUOMRepository,
            IDepotRepository depotRepository,
            IUnitOfWorkManager uow,
            IIdentityUserRepository identityUserRepository,
            IExtendedRoleRepository extendedRoleRepository,
            IDepotUserRoleRepository depotUserRoleRepository,
            ISalesTeamMemberRepository salesTeamMemberRepository,
            IInterfaceRepository interfaceRepository,
            // ============ INJECT CÁC REPOSITORY MỚI ============
            IRepository<WareHouseLocation, Guid> wareHouseLocationRepository,
            IRepository<InventoryDoc, Guid> inventoryDocRepository,
            IRepository<InventoryTransaction, Guid> inventoryTransactionRepository,
            IRepository<ItemWarehouse, Guid> itemWarehouseRepository,
            IRepository<ItemLocation, Guid> itemLocationRepository,
            IRepository<UnitOfMeasure, Guid> unitOfMeasureRepository
        ) : base(dbContextProvider, extendedUserRepository)
        {
            _configuration = configuration;
            _userManager = userManager;
            _passwordHasher = passwordHasher;
            _salesTeamRepository = salesTeamRepository;
            _binRepository = binRepository;
            _productRepository = productRepository;
            _deliveryAddressRepository = deliveryAddressRepository;
            _customerRepository = customerRepository;
            _productComponentRepository = productComponentRepository;
            _productUOMRepository = productUOMRepository;
            _depotRepository = depotRepository;
            _uow = uow;
            _identityUserRepository = identityUserRepository;
            _extendedRoleRepository = extendedRoleRepository;
            _depotUserRoleRepository = depotUserRoleRepository;
