    public class EfCoreStockTranferRepository : EfCoreSalePersonRepositoryBase, IStockTranferRepository
    {
        /// <summary>
        /// Số lượng lưu entity kho là <see cref="double"/>; tính trên <see cref="decimal"/> rồi làm tròn để khớp số nhập và tránh nhiễu float/binary.
        /// </summary>
        private const int InventoryQuantityDecimalPlaces = 10;

        private static double ToInventoryDouble(decimal value) =>
            (double)Math.Round(value, InventoryQuantityDecimalPlaces, MidpointRounding.AwayFromZero);

        private IConfiguration _configuration;
        private IdentityUserManager _userManager;
        private readonly IPasswordHasher<Volo.Abp.Identity.IdentityUser> _passwordHasher;
        private readonly ISalesTeamRepository _salesTeamRepository;
        private readonly IBinRepository _binRepository;
        private readonly IProductRepository _productRepository;
        private readonly IDeliveryAddressRepository _deliveryAddressRepository;
        private readonly ICustomerRepository _customerRepository;
        private readonly IProductComponentRepository _productComponentRepository;
        private readonly IProductUOMRepository _productUOMRepository;
        private readonly IDepotRepository _depotRepository;
        private readonly IUnitOfWorkManager _uow;
        private readonly IIdentityUserRepository _identityUserRepository;
        private readonly IExtendedRoleRepository _extendedRoleRepository;
        private readonly IDepotUserRoleRepository _depotUserRoleRepository;
        private readonly ISalesTeamMemberRepository _salesTeamMemberRepository;
        private readonly IInterfaceRepository _interfaceRepository;

        // ============ THÊM CÁC REPOSITORY TỪ INVENTORY MODULE ============
        private readonly IRepository<WareHouseLocation, Guid> _wareHouseLocationRepository;
        private readonly IRepository<InventoryDoc, Guid> _inventoryDocRepository;
        private readonly IRepository<InventoryTransaction, Guid> _inventoryTransactionRepository;
        private readonly IRepository<ItemWarehouse, Guid> _itemWarehouseRepository;
        private readonly IRepository<ItemLocation, Guid> _itemLocationRepository;
        private readonly IRepository<UnitOfMeasure, Guid> _unitOfMeasureRepository;

