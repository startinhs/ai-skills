      "name": "EPS260700232",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('isSuccess = true', () => pm.expect(r.isSuccess).to.eql(true));",
              "const req = r.requestData || '';",
              "const n = (req.match(/<Deleted>true<\\/Deleted>\\s*<\\/BUDGET_ALLOC>/g) || []).length;",
              "console.log(pm.info.requestName, 'isSuccess=', r.isSuccess, 'value=', r.value, 'budgetDeleted=', n, r.message);",
              "pm.test('Co AllocationCode 370 (API dung DB da chay 02)', () => pm.expect(req).to.include('<AllocationCode>370</AllocationCode>'));",
              "if (!req.includes('<AllocationCode>370</AllocationCode>')) { postman.setNextRequest(null); }"
            ]
          }
        }
      ],
      "request": {
